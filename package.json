{
  "name": "wealthgrowthtracker",
  "private": true,
  "version": "1.11.0-preview.2",
  "description": "WealthGrowthTracker — 本地优先的个人财富管理 Web 与桌面应用",
  "type": "module",
  "engines": {
    "node": "24.21.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "privacy:check": "node scripts/privacy-check.mjs",
    "privacy:history": "node scripts/privacy-history-governance.mjs",
    "privacy:test": "node --test scripts/privacy-check.test.mjs scripts/privacy-history-check.test.mjs scripts/privacy-history-governance.test.mjs",
    "brand:check": "node scripts/brand-check.mjs",
    "license:check": "node scripts/license-check.mjs",
    "cargo-license:check": "node scripts/cargo-license-check.mjs",
    "artifact:check": "node scripts/artifact-privacy-check.mjs",
    "audit:high": "npm audit --audit-level=high",
    "tauri": "tauri",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "4.3.3",
    "typescript": "~5.6.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
